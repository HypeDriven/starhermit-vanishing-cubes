aitu dezagun.","lessonSteps.t6.0":"Taula guztiek dituzte txorrotak eta errotazioak. Gutxiago irabazteak izarrak eta eraginkortasun-sariak ematen ditu. — Alferrikako txorrotak eta errotazioak kostatu zaizkie. Garbitu taula.","challenges.ch-exact-1":"Neurri zehatza.","challenges.ch-exact-2":"Neurri zehatza II.","challenges.ch-speed-1":"Laurogeita hamar segundo","challenges.ch-speed-2":"Bi minutu, nagusi.","challenges.ch-sparse-1":"Aire mehea","challenges.ch-core-1":"Funtsezko esposizioa","challenges.ch-grand-1":"Murrizketa Handia","challenges.ch-blind-1":"Ez dago instrumenturik.","challengeBlurbs.ch-exact-1":"Ez da alferrik galtzen. Mugimendu muga kubo kopuruaren parekoa da.","challengeBlurbs.ch-exact-2":"Lan huts bat harri batekin, eta ez dut ukitu bat ere.","challengeBlurbs.ch-speed-1":"Garbitu bilera zeruak ilundu baino lehen.","challengeBlurbs.ch-speed-2":"Lan handiagoa, fusible luzeagoa.","challengeBlurbs.ch-sparse-1":"— diseinu aldatuak hutsuneak irakurtzen ditu.","challengeBlurbs.ch-core-1":"Azaldu nukleoa denbora amaitu aurretik.","challengeBlurbs.ch-grand-1":"Zulo sakona, bi txorrotarekin.","challengeBlurbs.ch-blind-1":"Ez dago aztarnarik, ez dago atzera egiterik, eta kontu zorrotza.","themes.dawn":"Egunsenti zurbila","themes.verdant":"Lurreko itsasoa.","themes.ember":"Errauts Ilunabarra","themes.midnight":"Gauerdiko marea.","themes.mono":"Paper monoa","achievements.first-clear.0":"Lehen Argia","achievements.first-clear.1":"Bukatu lehen fasea.","achievements.key-master.0":"Giltza bakoitza biratzen","achievements.key-master.1":"Bidaiaren 10 etapa itxi.","achievements.daily-streak-3.0":"Esku finkoa","achievements.daily-streak-3.1":"Egunerokoa osatu. 3 Jarraian UTC Egunak.","achievements.grand-work.0":"Lan handia","achievements.grand-work.1":"Bidaiaren azken fasea, Azken Argia.","achievements.thousand-cubes.0":"Cube Millerrek","achievements.thousand-cubes.1":"1,000 kuboak askatu.","preparing":"Arbela prestatzen...","runtimeOptions":"Aukera gehiago","runtimeOptio